@model IEnumerable<ColegioSanJose.Models.DB.Materia>
@{
    ViewData["Title"] = "Materias";
}

<h1>Materias</h1>
<p>
    <a class="btn btn-primary" asp-action="NuevaMateria" asp-controller="Home">Nueva Materia</a>
</p>

<div class="row">
     <div class="col-md-12">
         <table class="table">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Nombre Materia</th>
                    <th scope="col">Docente</th>
                    <th scope="col">Editar</th>
                    <th scope="col">Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var materia in Model)
                {
                    <tr>
                        <td>@materia.MateriaId</td>
                        <td>@materia.NombreMateria</td>
                        <td>@materia.Docente</td>
                        <td>
                            <a class="btn btn-sm btn-secondary" asp-action="EditarMateria" asp-route-id="@materia.MateriaId">Editar</a>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#eliminarModal" data-materia-id="@materia.MateriaId" data-materia-nombre="@materia.NombreMateria">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
         </table>
     </div>
</div>

<div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="eliminarModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><strong>Eliminar una materia también borra todos sus expedientes relacionados</strong></p>
        <p>¿Está seguro de que desea eliminar la materia <strong id="materiaNombre"></strong>?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form id="eliminarForm" method="post" style="display:inline;">
            <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        document.getElementById('eliminarModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var materiaId = button.getAttribute('data-materia-id');
            var materiaNombre = button.getAttribute('data-materia-nombre');
            
            document.getElementById('materiaNombre').textContent = materiaNombre;
            
            var form = document.getElementById('eliminarForm');
            form.action = '/Home/EliminarMateria/' + materiaId;
        });
    </script>
}

