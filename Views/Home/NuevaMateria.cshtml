@model ColegioSanJose.Models.DB.Materia
@{
    ViewData["Title"] = "Nueva Materia";
}

<h1>Nueva Materia</h1>

@if (!ViewData.ModelState.IsValid)
{
    @if (ViewData.ModelState.Values.Any(v => v.Errors.Any(e => e.ErrorMessage.Contains("Registro ya existente"))))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> Registro ya existente. Edite o cree uno nuevo.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    else
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> Todos los campos son obligatorios.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}

@using (Html.BeginForm("NuevaMateria", "Home", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.NombreMateria)
        @Html.TextBoxFor(m => m.NombreMateria, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Docente)
        @Html.TextBoxFor(m => m.Docente, new { @class = "form-control" })
    </div>
    <input type="submit" value="Crear" class="btn btn-primary" />
    <a href="@Url.Action("Materias", "Home")" class="btn btn-secondary">Cancelar</a>
}
