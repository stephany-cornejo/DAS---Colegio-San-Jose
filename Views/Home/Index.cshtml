@model IEnumerable<ColegioSanJose.Models.DB.Expediente>
@{
    ViewData["Title"] = "Expedientes";
}

<h1>Expedientes</h1>
<p>
    <a class="btn btn-primary" asp-action="NuevoExpediente" asp-controller="Home">Nuevo Expediente</a>
</p>
<div class="row">
     <div class="col-md-12">
         <table class="table">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Nombre Completo</th>
                    <th scope="col">Materia</th>
                    <th scope="col">Nota Final</th>
                    <th scope="col">Observaciones</th>
                    <th scope="col">Editar</th>
                    <th scope="col">Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.ExtpedienteId</td>
                        <td>@d.Alumno?.Nombre @d.Alumno?.Apellido</td>
                        <td>@d.Materia?.NombreMateria</td>
                        <td>@d.NotaFinal</td>
                        <td>@d.Observaciones</td>
                        <td>
                            <a class="btn btn-sm btn-secondary" asp-action="Editar" asp-route-id="@d.ExtpedienteId">Editar</a>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#eliminarExpedienteModal" data-id="@d.ExtpedienteId">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
         </table>
     </div>
</div>

<div class="modal fade" id="eliminarExpedienteModal" tabindex="-1" aria-labelledby="eliminarExpedienteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar este expediente?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a class="btn btn-danger" id="eliminarExpedienteBtn">Aceptar</a>
            </div>
        </div>
    </div>
</div>

<script>
    const eliminarExpedienteModal = document.getElementById('eliminarExpedienteModal');
    eliminarExpedienteModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        const eliminarBtn = document.getElementById('eliminarExpedienteBtn');
        eliminarBtn.href = '@Html.Raw(Url.Action("Eliminar", "Home"))' + '?d=' + id;
    });
</script>